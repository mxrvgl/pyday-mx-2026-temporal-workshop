# Copy to .env to override. Every value below is the default.

# A pause after each checkout step, so there's time to break something mid-order.
STEP_DELAY_S=2

# Part 2: the support agent calls Claude with your key (https://console.anthropic.com).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# Ports on your machine.
CHECKOUT_PORT=8000
INVENTORY_PORT=8001
PROVIDER_PORT=8002
SUPPORT_PORT=8003
POSTGRES_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
